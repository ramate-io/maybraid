@@ -0,0 +1,109 @@
+//! Authored volume, obstacle, and timeline contract for v1 dust samples.
+
+use bevy::prelude::*;
+
+/// Packed 49-frame, 15 Hz playback window covering `[0, DURATION]`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustPlaybackFrames {
+	pub current: u32,
+	pub next: u32,
+	pub blend: f32,
+}
+
+impl DustPlaybackFrames {
+	pub fn as_tuple(self) -> (u32, u32, f32) {
+		(self.current, self.next, self.blend)
+	}
+}
+
+/// One authored exclusion box. Half-extents match the playback shader.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustObstacle {
+	pub centre: Vec3,
+	pub half_extent: Vec3,
+}
+
+impl DustObstacle {
+	pub fn size(self) -> Vec3 {
+		self.half_extent * 2.0
+	}
+}
+
+/// Spatial box, frame count, and the two diagnostic obstacle volumes.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustBounds {
+	pub min: Vec3,
+	pub max: Vec3,
+}
+
+impl DustBounds {
+	pub const DURATION: f32 = 3.2;
+	pub const FRAME_RATE: f32 = 15.0;
+	pub const FRAME_COUNT: u32 = 49;
+	pub const LAST_FRAME: u32 = 48;
+	pub const GROUND_FALLOFF: f32 = 0.025;
+	pub const CAPTURE_WIDTH_M: f32 = 7.8;
+	pub const QUAD_CENTRE: Vec3 = Vec3::new(0.0, 0.55, 0.0);
+
+	pub const V1: Self = Self { min: Vec3::new(-3.2, 0.0, -3.2), max: Vec3::new(3.2, 3.2, 3.2) };
+
+	pub const WALL: DustObstacle = DustObstacle {
+		centre: Vec3::new(0.65, 0.7, -0.3),
+		half_extent: Vec3::new(0.15, 0.7, 1.25),
+	};
+
+	pub const BOX: DustObstacle =
+		DustObstacle { centre: Vec3::new(-1.0, 0.4, -0.7), half_extent: Vec3::new(0.4, 0.4, 0.4) };
+
+	pub const OBSTACLES: [DustObstacle; 2] = [Self::WALL, Self::BOX];
+
+	pub fn size(self) -> Vec3 {
+		self.max - self.min
+	}
+
+	pub fn contains_time(t: f32) -> bool {
+		t.is_finite() && (0.0..=Self::DURATION).contains(&t)
+	}
+
+	pub fn clamp_time(t: f32) -> f32 {
+		t.clamp(0.0, Self::DURATION)
+	}
+
+	/// Source-frame pair and blend for a simulation timestamp.
+	pub fn frames(t: f32) -> DustPlaybackFrames {
+		let f = Self::clamp_time(t) * Self::FRAME_RATE;
+		let current = (f.floor() as u32).min(Self::LAST_FRAME);
+		DustPlaybackFrames {
+			current,
+			next: (current + 1).min(Self::LAST_FRAME),
+			blend: f - current as f32,
+		}
+	}
+}
+
+impl Default for DustBounds {
+	fn default() -> Self {
+		Self::V1
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn time_clamps_and_interpolates() {
+		assert_eq!(DustBounds::frames(-1.0).as_tuple(), (0, 1, 0.0));
+		assert_eq!(DustBounds::frames(0.1).as_tuple(), (1, 2, 0.5));
+		assert_eq!(DustBounds::frames(9.0).as_tuple(), (48, 48, 0.0));
+		assert!(DustBounds::contains_time(0.7));
+		assert!(!DustBounds::contains_time(3.21));
+	}
+
+	#[test]
+	fn obstacle_sizes_match_authored_geometry() {
+		assert_eq!(DustBounds::WALL.size(), Vec3::new(0.3, 1.4, 2.5));
+		assert_eq!(DustBounds::BOX.size(), Vec3::new(0.8, 0.8, 0.8));
+		assert_eq!(DustBounds::V1.size(), Vec3::new(6.4, 3.2, 6.4));
+	}
+}
diff --git a/maybraid/vfx/lib/src/dust/disturbance.rs b/maybraid/vfx/lib/src/dust/disturbance.rs
new file mode 100644
index 000000000..3c53237e1
--- /dev/null
+++ b/maybraid/vfx/lib/src/dust/disturbance.rs
@@ -0,0 +1,80 @@
+//! Local, stateless influence used by the dust playback shader.
+
+use bevy::prelude::*;
+
+/// Smoothed mover used to clear and shift nearby coverage/density.
+///
+/// The GPU path stays stateless: a radial weight, a ≤ 0.16 m coordinate shift,
+/// and no pileup or wake. These fields pack into the playback uniform.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustDisturbance {
+	pub position: Vec3,
+	pub velocity: Vec3,
+	pub strength: f32,
+	pub radius: f32,
+}
+
+impl DustDisturbance {
+	pub const RADIUS: f32 = 0.85;
+	pub const MAX_SPEED: f32 = 4.0;
+	pub const MAX_VELOCITY: f32 = 3.0;
+	pub const SMOOTHING: f32 = 0.18;
+	pub const SHIFT_SCALE: f32 = 0.055;
+	pub const CLEAR_SCALE: f32 = 0.58;
+
+	pub fn idle_at(position: Vec3) -> Self {
+		Self { position, velocity: Vec3::ZERO, strength: 0.0, radius: Self::RADIUS }
+	}
+
+	pub fn target_strength(speed: f32, interact: bool) -> f32 {
+		if interact {
+			speed.min(Self::MAX_SPEED) / Self::MAX_SPEED
+		} else {
+			0.0
+		}
+	}
+
+	pub fn smooth_strength(current: f32, target: f32, dt: f32) -> f32 {
+		current + (target - current) * (1.0 - (-dt / Self::SMOOTHING).exp())
+	}
+
+	pub fn packed_influence(self) -> Vec4 {
+		self.position.extend(self.strength)
+	}
+
+	pub fn packed_velocity(self) -> Vec4 {
+		self.velocity.clamp_length_max(Self::MAX_VELOCITY).extend(self.radius)
+	}
+}
+
+impl Default for DustDisturbance {
+	fn default() -> Self {
+		Self::idle_at(Vec3::ZERO)
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn interaction_scales_and_clamps_speed() {
+		assert_eq!(DustDisturbance::target_strength(2.0, false), 0.0);
+		assert!((DustDisturbance::target_strength(2.0, true) - 0.5).abs() < 1e-6);
+		assert_eq!(DustDisturbance::target_strength(8.0, true), 1.0);
+	}
+
+	#[test]
+	fn packing_clamps_velocity_and_keeps_radius() {
+		let field = DustDisturbance {
+			position: Vec3::new(1.0, 0.4, 0.1),
+			velocity: Vec3::X * 9.0,
+			strength: 0.25,
+			radius: DustDisturbance::RADIUS,
+		};
+		assert_eq!(field.packed_influence(), Vec4::new(1.0, 0.4, 0.1, 0.25));
+		let packed = field.packed_velocity();
+		assert!((packed.truncate().length() - DustDisturbance::MAX_VELOCITY).abs() < 1e-5);
+		assert!((packed.w - DustDisturbance::RADIUS).abs() < 1e-6);
+	}
+}
diff --git a/maybraid/vfx/lib/src/dust/material.rs b/maybraid/vfx/lib/src/dust/material.rs
new file mode 100644
index 000000000..f957abdfb
--- /dev/null
+++ b/maybraid/vfx/lib/src/dust/material.rs
@@ -0,0 +1,112 @@
+//! Embedded dust playback material.
+
+use bevy::asset::embedded_asset;
+use bevy::mesh::MeshVertexBufferLayoutRef;
+use bevy::pbr::{MaterialPipeline, MaterialPipelineKey};
+use bevy::prelude::*;
+use bevy::render::render_resource::{
+	AsBindGroup, CompareFunction, RenderPipelineDescriptor, SpecializedMeshPipelineError,
+};
+use bevy::shader::ShaderRef;
+
+use crate::dust::playback::DustPlayback;
+
+pub const DUST_SHADER_ASSET: &str =
+	concat!("embedded://", env!("CARGO_CRATE_NAME"), "/", "dust/shader.wgsl");
+
+#[derive(Asset, TypePath, AsBindGroup, Debug, Clone)]
+pub struct DustPlaybackMaterial {
+	#[uniform(0)]
+	pub playback: DustPlayback,
+	#[texture(1)]
+	#[sampler(2)]
+	pub atlas: Handle<Image>,
+	#[texture(3, dimension = "3d")]
+	#[sampler(4)]
+	pub density: Handle<Image>,
+	#[texture(5, dimension = "2d_array")]
+	#[sampler(6)]
+	pub multiview: Handle<Image>,
+}
+
+impl DustPlaybackMaterial {
+	pub fn new(
+		playback: DustPlayback,
+		atlas: Handle<Image>,
+		density: Handle<Image>,
+		multiview: Handle<Image>,
+	) -> Self {
+		Self { playback, atlas, density, multiview }
+	}
+}
+
+impl Material for DustPlaybackMaterial {
+	fn vertex_shader() -> ShaderRef {
+		DUST_SHADER_ASSET.into()
+	}
+
+	fn fragment_shader() -> ShaderRef {
+		DUST_SHADER_ASSET.into()
+	}
+
+	fn alpha_mode(&self) -> AlphaMode {
+		AlphaMode::Blend
+	}
+
+	fn enable_prepass() -> bool {
+		false
+	}
+
+	fn enable_shadows() -> bool {
+		false
+	}
+
+	fn specialize(
+		_pipeline: &MaterialPipeline,
+		descriptor: &mut RenderPipelineDescriptor,
+		_layout: &MeshVertexBufferLayoutRef,
+		_key: MaterialPipelineKey<Self>,
+	) -> Result<(), SpecializedMeshPipelineError> {
+		descriptor.primitive.cull_mode = None;
+		if let Some(depth) = descriptor.depth_stencil.as_mut() {
+			depth.depth_write_enabled = Some(false);
+			depth.depth_compare = Some(CompareFunction::Always);
+		}
+		Ok(())
+	}
+}
+
+/// Embedded dust shader plus [`MaterialPlugin`].
+pub struct DustPlaybackPlugin;
+
+impl Plugin for DustPlaybackPlugin {
+	fn build(&self, app: &mut App) {
+		embedded_asset!(app, "shader.wgsl");
+		if !app.is_plugin_added::<MaterialPlugin<DustPlaybackMaterial>>() {
+			app.add_plugins(MaterialPlugin::<DustPlaybackMaterial>::default());
+		}
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn fragment_shader_ref_matches_embedded_asset_path() {
+		match <DustPlaybackMaterial as Material>::fragment_shader() {
+			ShaderRef::Path(path) => assert_eq!(path.to_string(), DUST_SHADER_ASSET),
+			ShaderRef::Default => panic!("unexpected Default shader ref"),
+			ShaderRef::Handle(_) => panic!("unexpected Handle shader ref"),
+		}
+	}
+
+	#[test]
+	fn embedded_wgsl_registers_with_asset_plugin() {
+		let mut app = App::new();
+		app.add_plugins(MinimalPlugins);
+		app.add_plugins(AssetPlugin::default());
+		embedded_asset!(app, "shader.wgsl");
+		app.update();
+	}
+}
diff --git a/maybraid/vfx/lib/src/dust/playback.rs b/maybraid/vfx/lib/src/dust/playback.rs
new file mode 100644
index 000000000..e0135ba7f
--- /dev/null
+++ b/maybraid/vfx/lib/src/dust/playback.rs
@@ -0,0 +1,185 @@
+//! CPU-side playback uniform and representation mode.
+
+use bevy::prelude::*;
+use bevy::render::render_resource::ShaderType;
+
+use crate::dust::bounds::DustBounds;
+use crate::dust::disturbance::DustDisturbance;
+
+/// Authored capture plane basis for representation B.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustCaptureBasis {
+	pub right: Vec3,
+	pub up: Vec3,
+	pub centre: Vec3,
+}
+
+impl DustCaptureBasis {
+	pub fn packed_right(self) -> Vec4 {
+		self.right.extend(0.0)
+	}
+
+	pub fn packed_up(self) -> Vec4 {
+		self.up.extend(0.0)
+	}
+
+	pub fn packed_centre(self) -> Vec4 {
+		self.centre.extend(0.0)
+	}
+}
+
+/// Optical and sampling overrides packed into `experiment`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DustExperiment {
+	pub nearest: bool,
+	pub density_multiplier: f32,
+	pub boundary_exclusion: bool,
+}
+
+impl DustExperiment {
+	pub fn packed(self) -> Vec4 {
+		Vec4::new(
+			if self.nearest { 1.0 } else { 0.0 },
+			self.density_multiplier,
+			if self.boundary_exclusion { 1.0 } else { 0.0 },
+			0.0,
+		)
+	}
+}
+
+/// B = fixed plane, B+ = eight-view ring, C = animated density.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DustRepresentation {
+	Plane,
+	MultiView,
+	Density,
+}
+
+impl DustRepresentation {
+	pub fn from_label(label: &str) -> Option<Self> {
+		match label {
+			"B" => Some(Self::Plane),
+			"B+" => Some(Self::MultiView),
+			"C" => Some(Self::Density),
+			_ => None,
+		}
+	}
+
+	pub fn label(self) -> &'static str {
+		match self {
+			Self::Plane => "B",
+			Self::MultiView => "B+",
+			Self::Density => "C",
+		}
+	}
+
+	/// Uniform `time.w`: 0 = B, 1 = C, 2 = B+.
+	pub fn mode(self) -> f32 {
+		match self {
+			Self::Plane => 0.0,
+			Self::Density => 1.0,
+			Self::MultiView => 2.0,
+		}
+	}
+
+	pub fn animation_gpu_bytes(self) -> usize {
+		match self {
+			Self::Density => 12_845_056,
+			Self::MultiView => crate::dust::DustMultiView::GPU_BYTES,
+			Self::Plane => 13_660_416,
+		}
+	}
+}
+
+/// GPU uniform. Layout must stay aligned with `shader.wgsl`.
+#[derive(Clone, Copy, Debug, ShaderType)]
+pub struct DustPlayback {
+	pub time: Vec4,      // i, j, blend, mode(0=B,1=C,2=B+)
+	pub settings: Vec4,  // group count, ray steps, sigmaT, active
+	pub influence: Vec4, // world xyz, smoothed movement strength
+	pub velocity: Vec4,  // xyz, radius
+	pub origins: [Vec4; 10],
+	pub right: Vec4,
+	pub up: Vec4,
+	pub centre: Vec4,
+	pub experiment: Vec4, // nearest-view, optical density, boundary exclusion, reserved
+}
+
+impl DustPlayback {
+	pub const SIGMA_T: f32 = 2.2;
+	pub const MAX_GROUPS: usize = 10;
+
+	pub fn new(
+		representation: DustRepresentation,
+		groups: u32,
+		steps: u32,
+		capture: DustCaptureBasis,
+		experiment: DustExperiment,
+	) -> Self {
+		Self {
+			time: Vec4::new(0.0, 1.0, 0.0, representation.mode()),
+			settings: Vec4::new(groups as f32, steps as f32, Self::SIGMA_T, 0.0),
+			influence: Vec4::ZERO,
+			velocity: Vec4::new(0.0, 0.0, 0.0, DustDisturbance::RADIUS),
+			origins: [Vec4::ZERO; Self::MAX_GROUPS],
+			right: capture.packed_right(),
+			up: capture.packed_up(),
+			centre: capture.packed_centre(),
+			experiment: experiment.packed(),
+		}
+	}
+
+	pub fn set_source_time(&mut self, t: f32) {
+		let frames = DustBounds::frames(t);
+		self.time.x = frames.current as f32;
+		self.time.y = frames.next as f32;
+		self.time.z = frames.blend;
+	}
+
+	pub fn set_active(&mut self, active: bool) {
+		self.settings.w = if active { 1.0 } else { 0.0 };
+	}
+
+	pub fn set_disturbance(&mut self, field: DustDisturbance) {
+		self.influence = field.packed_influence();
+		self.velocity = field.packed_velocity();
+	}
+
+	pub fn set_group_origin(&mut self, index: usize, origin: Vec3) {
+		if index < Self::MAX_GROUPS {
+			self.origins[index] = origin.extend(0.0);
+		}
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn labels_map_to_shader_modes() {
+		assert_eq!(DustRepresentation::from_label("B").unwrap().mode(), 0.0);
+		assert_eq!(DustRepresentation::from_label("C").unwrap().mode(), 1.0);
+		assert_eq!(DustRepresentation::from_label("B+").unwrap().mode(), 2.0);
+		assert_eq!(DustRepresentation::from_label("nope"), None);
+	}
+
+	#[test]
+	fn set_source_time_writes_interpolated_frames() {
+		let capture =
+			DustCaptureBasis { right: Vec3::X, up: Vec3::Y, centre: DustBounds::QUAD_CENTRE };
+		let mut playback = DustPlayback::new(
+			DustRepresentation::Density,
+			1,
+			96,
+			capture,
+			DustExperiment { nearest: false, density_multiplier: 1.0, boundary_exclusion: false },
+		);
+		playback.set_source_time(0.1);
+		assert_eq!(playback.time.x, 1.0);
+		assert_eq!(playback.time.y, 2.0);
+		assert!((playback.time.z - 0.5).abs() < 1e-6);
+		playback.set_active(true);
+		assert_eq!(playback.settings.w, 1.0);
+	}
+}
diff --git a/maybraid/vfx/lib/src/dust/shader.wgsl b/maybraid/vfx/lib/src/dust/shader.wgsl
new file mode 100644
index 000000000..390c7d5b9
--- /dev/null
+++ b/maybraid/vfx/lib/src/dust/shader.wgsl
@@ -0,0 +1,165 @@
+#import bevy_pbr::{mesh_view_bindings::view, view_transformations::{position_ndc_to_world,frag_coord_to_ndc}, prepass_utils::prepass_depth}
+#import bevy_core_pipeline::tonemapping::tone_mapping
+struct Playback {
+ time:vec4<f32>, settings:vec4<f32>, influence:vec4<f32>, velocity:vec4<f32>,
+ origins:array<vec4<f32>,10>, right:vec4<f32>, up:vec4<f32>, centre:vec4<f32>, experiment:vec4<f32>,
+}
+@group(#{MATERIAL_BIND_GROUP}) @binding(0) var<uniform> p:Playback;
+@group(#{MATERIAL_BIND_GROUP}) @binding(1) var atlas:texture_2d<f32>;
+@group(#{MATERIAL_BIND_GROUP}) @binding(2) var atlas_sampler:sampler;
+@group(#{MATERIAL_BIND_GROUP}) @binding(3) var density:texture_3d<f32>;
+@group(#{MATERIAL_BIND_GROUP}) @binding(4) var density_sampler:sampler;
+@group(#{MATERIAL_BIND_GROUP}) @binding(5) var multiview:texture_2d_array<f32>;
+@group(#{MATERIAL_BIND_GROUP}) @binding(6) var multiview_sampler:sampler;
+struct Out {@builtin(position) position:vec4<f32>,}
+@vertex fn vertex(@location(0) position:vec3<f32>)->Out {
+ var out:Out;out.position=vec4(position.xy,0.5,1.0);return out;
+}
+fn atlas_frame(uv:vec2<f32>,frame:u32)->vec4<f32> {
+ let tile=vec2<f32>(f32(frame%7u),f32(frame/7u));
+ return textureSampleLevel(atlas,atlas_sampler,(tile*264.0+vec2(4.5)+clamp(uv,vec2(0.0),vec2(1.0))*255.0)/1848.0,0.0);
+}
+// Each sample is premultiplied in linear RGB before time or angular interpolation.
+fn multiview_frame(uv:vec2<f32>,frame:u32,angle:u32)->vec4<f32> {
+ let tile=vec2<f32>(f32(frame%7u),f32(frame/7u));
+ let q=(tile*136.0+vec2(4.5)+clamp(uv,vec2(0.0),vec2(1.0))*127.0)/952.0;
+ let a=textureSampleLevel(multiview,multiview_sampler,q,i32(angle),0.0);
+ return vec4(a.rgb*a.a,a.a);
+}
+fn box_sdf(world:vec3<f32>,centre:vec3<f32>,half_size:vec3<f32>)->f32 {
+ let q=abs(world-centre)-half_size;
+ return length(max(q,vec3(0.0)))+min(max(q.x,max(q.y,q.z)),0.0);
+}
+fn boundary_mask(world:vec3<f32>)->f32 {
+ // True zero-density exclusion at/inside the two fixed test boxes. This is NOT flow or a contact solver.
+ if p.experiment.z<0.5 {return 1.0;}
+ let wall=box_sdf(world,vec3(0.65,0.7,-0.3),vec3(0.15,0.7,1.25));
+ let box=box_sdf(world,vec3(-1.0,0.4,-0.7),vec3(0.4));
+ return smoothstep(0.0,0.08,min(wall,box))*smoothstep(0.0,0.025,world.y);
+}
+fn optical_coverage(alpha:f32)->f32 {
+ return 1.0-pow(max(1.0-alpha,0.000001),p.experiment.y);
+}
+fn density_frame(uvw:vec3<f32>,frame:u32)->f32 {
+ // Prevent filtering into the adjacent *animation* cell. Explicitly zero outside spatial bounds.
+ if any(uvw<vec3(0.0)) || any(uvw>vec3(1.0)) {return 0.0;}
+ let q=clamp(uvw,vec3(0.5/64.0,0.5/32.0,0.5/64.0),vec3(1.0-0.5/64.0,1.0-0.5/32.0,1.0-0.5/64.0));
+ let tile=vec2<f32>(f32(frame%7u),f32(frame/7u));
+ return textureSampleLevel(density,density_sampler,vec3((tile+q.xy)/7.0,q.z),0.0).r;
+}
+fn disturb(world:vec3<f32>)->vec4<f32> {
+ let d=(world-p.influence.xyz)/p.velocity.w;
+ let weight=exp(-dot(d,d)*2.5)*p.influence.w;
+ // Smooth, stateless local clearing + <= 0.16m coordinate shift. No pileup or wake.
+ return vec4(p.velocity.xyz*weight*0.055,1.0-0.58*weight);
+}
+fn rho(world:vec3<f32>)->f32 {
+ let field=disturb(world);
+ var sum=0.0;
+ for(var g=0u;g<u32(p.settings.x);g+=1u) {
+  let local=world-p.origins[g].xyz;
+  let uvw=(local-field.xyz-vec3(-3.2,0.0,-3.2))/vec3(6.4,3.2,6.4);
+  let a=density_frame(uvw,u32(p.time.x));let b=density_frame(uvw,u32(p.time.y));
+  // Cap perturbed density by unperturbed density: distortion cannot create a density increase.
+  let original_uvw=(local-vec3(-3.2,0.0,-3.2))/vec3(6.4,3.2,6.4);
+  var value=mix(a,b,p.time.z);
+  if p.influence.w>0.001 {value=min(value,mix(density_frame(original_uvw,u32(p.time.x)),density_frame(original_uvw,u32(p.time.y)),p.time.z));}
+  sum+=value*field.w;
+ }
+ return sum*boundary_mask(world)*p.experiment.y;
+}
+fn hit_box(ro:vec3<f32>,rd:vec3<f32>,origin:vec3<f32>)->vec2<f32> {
+ let inv=1.0/(select(vec3(0.000001),rd,abs(rd)>vec3(0.000001)));
+ let a=(origin+vec3(-3.2,0.0,-3.2)-ro)*inv;
+ let b=(origin+vec3(3.2,3.2,3.2)-ro)*inv;
+ let lo=min(a,b);let hi=max(a,b);
+ return vec2(max(max(lo.x,lo.y),lo.z),min(min(hi.x,hi.y),hi.z));
+}
+fn baked_view(ro:vec3<f32>,rd:vec3<f32>,limit:f32,origin:vec3<f32>,angle:u32)->vec4<f32> {
+ // Reconstruct each authored orthographic plane in ITS OWN world basis, not the old B plane.
+ let theta=f32(angle)*0.7853981633974483;
+ let elevation=0.3490658503988659;
+ let right=vec3(cos(theta),0.0,-sin(theta));
+ let up=vec3(-sin(elevation)*sin(theta),cos(elevation),-sin(elevation)*cos(theta));
+ let normal=cross(right,up);
+ let centre=vec3(0.0,0.55,0.0)+origin;
+ let denom=dot(rd,normal);
+ if abs(denom)<0.00001 {return vec4(0.0);}
+ let t=dot(centre-ro,normal)/denom;
+ if t<=0.0 || t>=limit {return vec4(0.0);}
+ let world=ro+rd*t;let field=disturb(world);
+ let delta=world-centre;
+ let uv=vec2(dot(delta,right)/7.8+0.5,0.5-dot(delta,up)/7.8);
+ if any(uv<vec2(0.0)) || any(uv>vec2(1.0)) {return vec4(0.0);}
+ let shift=vec2(dot(field.xyz,right),-dot(field.xyz,up))/7.8;
+ let a=multiview_frame(uv-shift,u32(p.time.x),angle);
+ let b=multiview_frame(uv-shift,u32(p.time.y),angle);
+ let sample=mix(a,b,p.time.z);
+ var coverage=sample.a;
+ if p.influence.w>0.001 {
+  let original=mix(multiview_frame(uv,u32(p.time.x),angle),multiview_frame(uv,u32(p.time.y),angle),p.time.z);
+  coverage=min(coverage,original.a);
+ }
+ let alpha=optical_coverage(coverage)*smoothstep(0.0,0.18,limit-t)*field.w*boundary_mask(world);
+ return vec4(sample.rgb/max(sample.a,0.000001)*alpha,alpha);
+}
+@fragment fn fragment(input:Out)->@location(0) vec4<f32> {
+ if p.settings.w<0.5 {return vec4(0.0);}
+ let ndc=frag_coord_to_ndc(input.position);
+ let ro=view.world_position.xyz;
+ let rd=normalize(position_ndc_to_world(vec3(ndc.xy,1.0))-ro);
+ let opaque=prepass_depth(input.position,0u);
+ var limit=1000.0;
+ if opaque>0.0 {limit=max(0.0,dot(position_ndc_to_world(vec3(ndc.xy,opaque))-ro,rd));}
+ var rgb=vec3(0.0);var trans=1.0;
+ if p.time.w<0.5 {
+  // A fixed capture plane per group, solved analytically. It remains a 2D representation.
+  let normal=normalize(cross(p.right.xyz,p.up.xyz));
+  let denom=dot(rd,normal);
+  if abs(denom)<0.00001 {return vec4(0.0);}
+  for(var g=0u;g<u32(p.settings.x);g+=1u) {
+   let centre=p.centre.xyz+p.origins[g].xyz;
+   let t=dot(centre-ro,normal)/denom;
+   if t<=0.0 || t>=limit {continue;}
+   let world=ro+rd*t;let delta=world-centre;
+   let uv=vec2(dot(delta,p.right.xyz)/7.8+0.5,0.5-dot(delta,p.up.xyz)/7.8);
+   if any(uv<vec2(0.0)) || any(uv>vec2(1.0)) {continue;}
+   let a=atlas_frame(uv,u32(p.time.x));let b=atlas_frame(uv,u32(p.time.y));
+   // Premultiplied interpolation then straight-alpha output: no color fringes at frame fades.
+   let coverage=mix(a.a,b.a,p.time.z);
+   let color=mix(a.rgb*a.a,b.rgb*b.a,p.time.z)/max(coverage,0.000001);
+   let alpha=optical_coverage(coverage)*boundary_mask(world)*smoothstep(0.0,0.18,limit-t)*disturb(world).w;
+   rgb+=trans*alpha*color;trans*=1.0-alpha;
+  }
+ } else if p.time.w>1.5 {
+  for(var g=0u;g<u32(p.settings.x);g+=1u) {
+   let offset=ro-(vec3(0.0,0.55,0.0)+p.origins[g].xyz);
+   let theta=atan2(offset.x,offset.z);
+   let angle=(theta/6.283185307179586-floor(theta/6.283185307179586))*8.0;
+   var i=u32(floor(angle))%8u;var j=(i+1u)%8u;var blend=fract(angle);
+   blend=blend*blend*(3.0-2.0*blend);
+   if p.experiment.x>0.5 {i=u32(floor(angle+0.5))%8u;j=i;blend=0.0;}
+   let a=baked_view(ro,rd,limit,p.origins[g].xyz,i);
+   var sample=a;
+   if j!=i {sample=mix(a,baked_view(ro,rd,limit,p.origins[g].xyz,j),blend);}
+   rgb+=trans*sample.rgb;trans*=1.0-sample.a;
+  }
+ } else {
+  var start=1000.0;var end=0.0;
+  for(var g=0u;g<u32(p.settings.x);g+=1u) {let hit=hit_box(ro,rd,p.origins[g].xyz);if hit.y>max(hit.x,0.0) {start=min(start,max(hit.x,0.0));end=max(end,hit.y);}}
+  end=min(end,limit);
+  if end<=start {return vec4(0.0);}
+  let step=(end-start)/p.settings.y;
+  // Uniform bounded midpoint quadrature; sum all overlapping groups *before* Beer-Lambert.
+  for(var s=0u;s<u32(p.settings.y);s+=1u) {
+   let world=ro+rd*(start+(f32(s)+0.5)*step);
+   let d=rho(world);let alpha=1.0-exp(-p.settings.z*d*step);
+   // Reference approximation: constant unlit earth source color, no self-shadowing or phase term.
+   rgb+=trans*alpha*vec3(0.381326,0.246201,0.135633);trans*=1.0-alpha;
+   if trans<0.003 {break;}
+  }
+ }
+ let alpha=1.0-trans;
+ let mapped=tone_mapping(vec4(rgb/max(alpha,0.000001),1.0),view.color_grading);
+ return vec4(mapped.rgb,alpha);
+}
diff --git a/maybraid/vfx/playground/examples/matched_dust.rs b/maybraid/vfx/playground/examples/matched_dust.rs
new file mode 100644
index 000000000..4dee48a3c
--- /dev/null
+++ b/maybraid/vfx/playground/examples/matched_dust.rs
@@ -0,0 +1,657 @@
+//! Independent B/B+/C Houdini playback comparison; consumes `maybraid-vfx` dust APIs.
+use bevy::{
+	camera::visibility::NoFrustumCulling,
+	core_pipeline::{prepass::DepthPrepass, tonemapping::Tonemapping},
+	prelude::*,
+	render::view::screenshot::{save_to_disk, Screenshot},
+	window::{PresentMode, WindowResolution},
+};
+use clap::Parser;
+use maybraid_vfx::dust::{
+	DustBounds, DustBundle, DustDisturbance, DustExperiment, DustMultiView, DustPlayback,
+	DustPlaybackMaterial, DustPlaybackPlugin, DustRepresentation,
+};
+use std::{path::PathBuf, time::Instant};
+
+#[derive(Parser, Resource, Debug)]
+struct Args {
+	/// B = original fixed plane; B+ = eight-view baked ring; C = animated density.
+	#[arg(default_value = "C", value_parser = ["B", "B+", "C"])]
+	representation: String,
+	/// Parent directory of wind_dust_demos and wind_dust_multiview.
+	#[arg(long)]
+	data_root: Option<PathBuf>,
+	/// Accepted for the prebuilt Mac binary; the workspace example uses the embedded shader.
+	#[arg(long, hide = true)]
+	#[allow(dead_code)]
+	shader_root: Option<PathBuf>,
+	/// Start paused at an exact simulation timestamp (interactive inspection).
+	#[arg(long)]
+	at: Option<f32>,
+	/// Save a single engine-rendered inspection image, then exit.
+	#[arg(long)]
+	still: Option<PathBuf>,
+	#[arg(
+		long,
+		default_value = "medium",
+		value_parser = ["medium", "distant", "orbit", "grazing", "entry", "inside", "moving", "stop", "elevated"]
+	)]
+	view: String,
+	#[arg(long, default_value_t = 1, value_parser = clap::value_parser!(u32).range(0..=10))]
+	groups: u32,
+	#[arg(long)]
+	obstacles: bool,
+	/// Diagnostic: keep obstacle masks active while hiding opaque wall/box geometry.
+	#[arg(long, requires = "obstacles")]
+	hide_obstacle_geometry: bool,
+	#[arg(long)]
+	interaction: bool,
+	#[arg(long)]
+	markers: bool,
+	/// Fixed 60Hz simulation, 49 screenshots at the source's 15Hz; *not* real-time video.
+	#[arg(long)]
+	sequence: Option<PathBuf>,
+	/// Real-time benchmark length; no fixed steps, screenshot work or visual warmup included.
+	#[arg(long, default_value_t = 0.)]
+	benchmark: f32,
+	/// Bounded sampling budget: C 96/48 ray steps, B+ adjacent blend/nearest.
+	#[arg(long, default_value = "default", value_parser = ["default", "lower"])]
+	profile: String,
+	#[arg(long, value_parser = clap::value_parser!(u32).range(24..=192))]
+	steps: Option<u32>,
+	#[arg(long, value_parser = ["blended", "nearest"])]
+	angular: Option<String>,
+	/// Freeze source density, while camera, influence and cleanup use advancing timeline.
+	#[arg(long)]
+	inspect_time: Option<f32>,
+	#[arg(long, default_value = "default", value_parser = ["default", "sparse", "denser"])]
+	density: String,
+	#[arg(long, default_value = "dense", value_parser = ["dense", "spread"])]
+	arrangement: String,
+	/// Diagnostic: obstacle geometry still occludes, but density/plane exclusion is disabled.
+	#[arg(long)]
+	no_boundary_exclusion: bool,
+	#[arg(long, default_value_t = 1)]
+	repeats: u32,
+	#[arg(long)]
+	result: Option<PathBuf>,
+}
+
+#[derive(Component)]
+struct DemoCamera;
+#[derive(Component)]
+struct DemoGroup;
+#[derive(Component)]
+struct Hud;
+#[derive(Component)]
+struct Influence;
+#[derive(Resource)]
+struct State {
+	material: Handle<DustPlaybackMaterial>,
+	started: Instant,
+	ready: bool,
+	snapshot: bool,
+	tick: u32,
+	elapsed: f32,
+	age: f32,
+	paused: bool,
+	strength: f32,
+	previous: Vec3,
+	frames: Vec<f64>,
+	focused_samples: usize,
+	captures: Vec<serde_json::Value>,
+	cycle: u32,
+	resource_samples: Vec<serde_json::Value>,
+	groups: Vec<Entity>,
+	mesh: Handle<Mesh>,
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+	let args = Args::parse();
+	if args.inspect_time.is_some_and(|t| !DustBounds::contains_time(t))
+		|| args.at.is_some_and(|t| !DustBounds::contains_time(t))
+		|| (args.at.is_some() && (args.sequence.is_some() || args.benchmark > 0.))
+		|| !args.benchmark.is_finite()
+		|| args.benchmark < 0.
+		|| args.benchmark > 120.
+		|| args.repeats == 0
+		|| args.repeats > 10
+		|| (args.sequence.is_some() && args.benchmark > 0.)
+	{
+		return Err("Invalid capture/benchmark/repeat settings".into());
+	}
+	if let Some(dir) = &args.sequence {
+		std::fs::create_dir_all(dir)?;
+	}
+	let representation =
+		DustRepresentation::from_label(&args.representation).ok_or("unsupported representation")?;
+	let data_root = args.data_root.clone().unwrap_or_else(DustBundle::showcase_data_root);
+	let bundle = DustBundle::read(data_root.join("wind_dust_demos"))?;
+	let atlas = if representation == DustRepresentation::Plane {
+		bundle.atlas()?
+	} else {
+		DustBundle::unused_atlas()
+	};
+	// B binds a tiny unused 3D texture; C binds a tiny unused 2D texture. Neither pays for the other's animation.
+	let density = if representation == DustRepresentation::Density {
+		bundle.density(args.markers)?
+	} else {
+		DustBundle::unused_density()
+	};
+	let multiview = if representation == DustRepresentation::MultiView {
+		DustMultiView::read(&bundle.multiview_root(), &bundle)?
+	} else {
+		DustMultiView::fallback()
+	};
+	let playback = DustPlayback::new(
+		representation,
+		args.groups,
+		args.steps(),
+		bundle.capture_basis()?,
+		DustExperiment {
+			nearest: args.nearest(),
+			density_multiplier: args.density_multiplier(),
+			boundary_exclusion: args.obstacles && !args.no_boundary_exclusion,
+		},
+	);
+	let mut app = App::new();
+	app.add_plugins(DefaultPlugins.set(WindowPlugin {
+		primary_window: Some(Window {
+			title: format!("Maybraid Dust {} — matched Houdini playback", args.representation),
+			resolution: WindowResolution::new(2560, 1440).with_scale_factor_override(2.),
+			present_mode: PresentMode::AutoNoVsync,
+			..default()
+		}),
+		..default()
+	}));
+	app.add_plugins(DustPlaybackPlugin);
+	let atlas = app.world_mut().resource_mut::<Assets<Image>>().add(atlas);
+	let density = app.world_mut().resource_mut::<Assets<Image>>().add(density);
+	let multiview = app.world_mut().resource_mut::<Assets<Image>>().add(multiview);
+	let material = app
+		.world_mut()
+		.resource_mut::<Assets<DustPlaybackMaterial>>()
+		.add(DustPlaybackMaterial::new(playback, atlas, density, multiview));
+	let mesh = app.world_mut().resource_mut::<Assets<Mesh>>().add(Rectangle::new(2., 2.));
+	app.insert_resource(State {
+		material,
+		mesh,
+		started: Instant::now(),
+		ready: false,
+		snapshot: false,
+		tick: 0,
+		elapsed: 0.,
+		age: 0.,
+		paused: false,
+		strength: 0.,
+		previous: Vec3::new(-2., 0.4, 0.1),
+		frames: Vec::with_capacity(8000),
+		focused_samples: 0,
+		captures: Vec::new(),
+		cycle: 0,
+		resource_samples: Vec::new(),
+		groups: Vec::new(),
+	})
+	.insert_resource(args)
+	.insert_resource(ClearColor(Color::srgb(0.13, 0.16, 0.19)))
+	.add_systems(Startup, setup)
+	.add_systems(Update, update)
+	.run();
+	Ok(())
+}
+
+fn setup(
+	mut commands: Commands,
+	state: Res<State>,
+	args: Res<Args>,
+	mut meshes: ResMut<Assets<Mesh>>,
+	mut materials: ResMut<Assets<StandardMaterial>>,
+) {
+	commands.insert_resource(GlobalAmbientLight { brightness: 180., ..default() });
+	commands.spawn((
+		DirectionalLight { illuminance: 4000., shadow_maps_enabled: true, ..default() },
+		Transform::from_xyz(5., 8., 4.).looking_at(Vec3::ZERO, Vec3::Y),
+	));
+	// Reference floor: geometry/lighting outside the animation, identical for B and C.
+	let tile = meshes.add(Cuboid::new(1., 0.04, 1.));
+	let shades = [
+		materials.add(Color::srgb(0.21, 0.23, 0.24)),
+		materials.add(Color::srgb(0.28, 0.30, 0.31)),
+	];
+	let floor_half = if args.arrangement == "spread" { 12i32 } else { 8i32 };
+	for z in -floor_half..floor_half {
+		for x in -floor_half..floor_half {
+			commands.spawn((
+				Mesh3d(tile.clone()),
+				MeshMaterial3d(shades[((x + z).rem_euclid(2)) as usize].clone()),
+				Transform::from_xyz(x as f32 + 0.5, -0.025, z as f32 + 0.5),
+			));
+		}
+	}
+	for (size, pos, color) in [
+		(Vec3::new(3.2, 0.015, 0.025), Vec3::new(1.6, 0.005, 0.), Color::srgb(0.65, 0.1, 0.08)),
+		(Vec3::new(0.025, 0.015, 3.2), Vec3::new(0., 0.005, 1.6), Color::srgb(0.07, 0.17, 0.7)),
+	] {
+		commands.spawn((
+			Mesh3d(meshes.add(Cuboid::from_size(size))),
+			MeshMaterial3d(materials.add(StandardMaterial {
+				base_color: color,
+				unlit: true,
+				..default()
+			})),
+			Transform::from_translation(pos),
+		));
+	}
+	if args.obstacles && !args.hide_obstacle_geometry {
+		for obstacle in DustBounds::OBSTACLES {
+			commands.spawn((
+				Mesh3d(meshes.add(Cuboid::from_size(obstacle.size()))),
+				MeshMaterial3d(materials.add(Color::srgb(0.16, 0.28, 0.34))),
+				Transform::from_translation(obstacle.centre),
+			));
+		}
+	}
+	commands.spawn((
+		Mesh3d(meshes.add(Sphere::new(0.16))),
+		MeshMaterial3d(materials.add(StandardMaterial {
+			base_color: Color::srgb(0.15, 0.7, 0.7),
+			unlit: true,
+			..default()
+		})),
+		Transform::from_xyz(-2., 0.4, 0.),
+		Influence,
+		if args.obstacles { Visibility::Visible } else { Visibility::Hidden },
+	));
+	commands.spawn((
+		Camera3d::default(),
+		Msaa::Off,
+		DepthPrepass,
+		Tonemapping::None,
+		Transform::from_xyz(6., 3.8, 7.2).looking_at(Vec3::new(0., 0.55, 0.), Vec3::Y),
+		DemoCamera,
+	));
+	commands.spawn((
+		Mesh3d(state.mesh.clone()),
+		MeshMaterial3d(state.material.clone()),
+		NoFrustumCulling,
+		Transform::default(),
+	));
+	commands.spawn((
+		Text::new("Preparing matched dust playback…"),
+		TextFont { font_size: 16.0.into(), ..default() },
+		TextColor(Color::srgb(0.92, 0.90, 0.8)),
+		Node {
+			position_type: PositionType::Absolute,
+			top: Val::Px(12.),
+			left: Val::Px(16.),
+			..default()
+		},
+		Hud,
+	));
+}
+
+impl State {
+	fn restart(&mut self, commands: &mut Commands, args: &Args) {
+		for entity in self.groups.drain(..) {
+			commands.entity(entity).try_despawn();
+		}
+		self.age = args.at.unwrap_or(0.);
+		self.paused = args.at.is_some();
+		self.strength = 0.;
+		self.previous = Vec3::new(-2., 0.4, 0.1);
+		for _ in 0..args.groups {
+			self.groups.push(commands.spawn(DemoGroup).id());
+		}
+	}
+
+	fn camera(&self, args: &Args) -> Transform {
+		args.camera(self.age)
+	}
+}
+
+impl Args {
+	fn camera(&self, t: f32) -> Transform {
+		let args = self;
+		let view = args.view.as_str();
+		let target = DustBounds::QUAD_CENTRE;
+		let mut pos = match view {
+			"distant" => Vec3::new(12., 6.5, 14.4),
+			"grazing" => Vec3::new(6., 0.22, 7.2),
+			"elevated" => Vec3::new(3.5, 7., 4.2),
+			"orbit" => {
+				// The fixed-step clock can finish a few microseconds short of 3.2s.
+				// Use the literal start pose at the endpoint, avoiding floor-edge raster differences.
+				let phase = (t / DustBounds::DURATION).clamp(0., 1.);
+				let a = if phase >= 1. - 0.00001 { 0. } else { std::f32::consts::TAU * phase };
+				Vec3::new(
+					a.sin() * 3.,
+					0.55 + 3. * DustMultiView::ELEVATION_DEGREES.to_radians().tan(),
+					a.cos() * 3.,
+				)
+			}
+			"inside" => Vec3::new(0.05, 0.45, 0.08),
+			"entry" => {
+				let r = (1. - t / 2.4).max(1. / 150.);
+				Vec3::new(6. * r, 0.45, 7.2 * r)
+			}
+			_ => Vec3::new(6., 3.8, 7.2),
+		};
+		if args.arrangement == "spread" && args.groups > 1 {
+			// A separate readable arrangement, not the dense-overlap stress budget.
+			pos *= if view == "orbit" { 4.5 } else { 2.0 };
+		}
+		Transform::from_translation(pos).looking_at(
+			if view == "inside" || view == "entry" { Vec3::new(-1., 0.45, -1.2) } else { target },
+			Vec3::Y,
+		)
+	}
+}
+
+// Avoid per-frame disk I/O or asset construction. Only the uniform and HUD change during playback.
+#[allow(clippy::too_many_arguments)]
+fn update(
+	mut commands: Commands,
+	args: Res<Args>,
+	mut state: ResMut<State>,
+	time: Res<Time<Real>>,
+	keys: Res<ButtonInput<KeyCode>>,
+	mut materials: ResMut<Assets<DustPlaybackMaterial>>,
+	mut camera: Query<&mut Transform, (With<DemoCamera>, Without<Influence>)>,
+	mut influence: Query<&mut Transform, (With<Influence>, Without<DemoCamera>)>,
+	mut hud: Query<&mut Text, With<Hud>>,
+	groups: Query<Entity, With<DemoGroup>>,
+	windows: Query<&Window>,
+	images: Res<Assets<Image>>,
+	mut exit: MessageWriter<AppExit>,
+) {
+	if !state.ready {
+		if state.started.elapsed().as_secs_f32() < 3. {
+			return;
+		}
+		state.ready = true;
+		state.started = Instant::now();
+		state.restart(&mut commands, &args);
+	}
+	if keys.just_pressed(KeyCode::Space) {
+		state.paused = !state.paused;
+	}
+	if keys.just_pressed(KeyCode::KeyR) {
+		state.restart(&mut commands, &args);
+	}
+	if state.paused {
+		if keys.just_pressed(KeyCode::ArrowRight) {
+			state.age = (state.age + 1. / DustBounds::FRAME_RATE).min(DustBounds::DURATION);
+		}
+		if keys.just_pressed(KeyCode::ArrowLeft) {
+			state.age = (state.age - 1. / DustBounds::FRAME_RATE).max(0.);
+		}
+	}
+	let dt = if args.sequence.is_some() { 1. / 60. } else { time.delta_secs().min(0.1) };
+	let capture_age = state.age;
+	let source_age = args.inspect_time.unwrap_or(capture_age);
+	if let Some(mut cam) = camera.iter_mut().next() {
+		*cam = state.camera(&args);
+	}
+	let mut pos = Vec3::new(-2. + (capture_age * 4.).min(4.), 0.4, 0.1);
+	if args.view == "stop" && capture_age > 0.65 {
+		pos.x = 0.6;
+	}
+	let velocity = (pos - state.previous) / dt.max(0.0001);
+	state.previous = pos;
+	let speed = velocity.length().min(DustDisturbance::MAX_SPEED);
+	let target = DustDisturbance::target_strength(speed, args.interaction);
+	if !state.paused {
+		state.strength = DustDisturbance::smooth_strength(state.strength, target, dt);
+	}
+	if let Some(mut t) = influence.iter_mut().next() {
+		t.translation = pos;
+	}
+	if let Some(mut mat) = materials.get_mut(&state.material) {
+		mat.playback.set_source_time(source_age);
+		mat.playback.set_active(capture_age <= DustBounds::DURATION);
+		if !state.paused {
+			mat.playback.set_disturbance(DustDisturbance {
+				position: pos,
+				velocity,
+				strength: state.strength,
+				radius: DustDisturbance::RADIUS,
+			});
+		}
+		for g in 0..args.groups as usize {
+			mat.playback.set_group_origin(g, args.origin(g as u32));
+		}
+	}
+	if let Some(mut text) = hud.iter_mut().next() {
+		**text = format!(
+			"{} | {} | {} groups ({}) | timeline {:.3}s | source {:.3}s | {}\nSpace pause · R restart · arrows step when paused | {} / {} | C {} steps | density {} | boundary exclusion {}",
+			args.representation,
+			args.view,
+			args.groups,
+			args.arrangement,
+			capture_age,
+			source_age,
+			if state.paused { "PAUSED" } else { "PLAYING" },
+			args.profile,
+			if args.nearest() { "nearest" } else { "adjacent blend" },
+			args.steps(),
+			args.density,
+			args.obstacles && !args.no_boundary_exclusion
+		);
+	}
+	if let Some(path) = &args.still {
+		if !state.snapshot && state.started.elapsed().as_secs_f32() > 0.5 {
+			commands.spawn(Screenshot::primary_window()).observe(save_to_disk(path.clone()));
+			state.snapshot = true;
+		}
+		if state.started.elapsed().as_secs_f32() > 1.5 {
+			exit.write(AppExit::Success);
+		}
+	}
+	// Sample the active *timeline* interval on every cycle, even if source time is frozen.
+	// This is real renderer wall-clock delta; captures cannot run alongside benchmark mode.
+	if args.benchmark > 0. && capture_age > 0.1 && capture_age < 1.8 {
+		state.frames.push(time.delta_secs_f64() * 1000.);
+		if windows.iter().any(|window| window.focused) {
+			state.focused_samples += 1;
+		}
+	}
+	if let Some(dir) = &args.sequence {
+		if state.tick.is_multiple_of(4) && state.tick <= 192 {
+			let frame = state.tick / 4;
+			commands
+				.spawn(Screenshot::primary_window())
+				.observe(save_to_disk(dir.join(format!("frame-{frame:04}.png"))));
+			let camera_position = state.camera(&args).translation.to_array();
+			let angular_views = args.angular_views(Vec3::from_array(camera_position));
+			state.captures.push(serde_json::json!({
+				"frame": frame,
+				"timestamp": capture_age,
+				"source_timestamp": source_age,
+				"source_frames": DustBounds::frames(source_age).as_tuple(),
+				"camera": camera_position,
+				"angular_views": angular_views
+			}));
+		}
+	}
+	if !state.paused {
+		state.age += dt;
+		state.elapsed += dt;
+		state.tick += 1;
+	}
+	if state.age > DustBounds::DURATION && !state.groups.is_empty() {
+		for entity in state.groups.drain(..) {
+			commands.entity(entity).try_despawn();
+		}
+	}
+	let timed = args.benchmark > 0. || args.sequence.is_some();
+	if state.age > 4.2
+		&& (!timed
+			|| args.benchmark > 0.
+			|| (args.sequence.is_some() && state.cycle + 1 < args.repeats))
+	{
+		state.resource_samples.push(serde_json::json!({
+			"groups_after_tail": groups.iter().count(),
+			"materials": materials.len(),
+			"images": images.len()
+		}));
+		state.cycle += 1;
+		state.restart(&mut commands, &args);
+	}
+	let finished = if args.benchmark > 0. {
+		state.elapsed >= args.benchmark
+	} else {
+		args.sequence.is_some() && state.age > 4.1 && state.cycle + 1 >= args.repeats
+	};
+	if finished {
+		let mut sorted = state.frames.clone();
+		sorted.sort_by(f64::total_cmp);
+		let n = sorted.len();
+		let window = windows.iter().next();
+		let representation = DustRepresentation::from_label(&args.representation)
+			.unwrap_or(DustRepresentation::Density);
+		let result = serde_json::json!({
+			"representation": args.representation,
+			"view": args.view,
+			"groups": args.groups,
+			"interaction": args.interaction,
+			"obstacles": args.obstacles,
+			"hide_obstacle_geometry": args.hide_obstacle_geometry,
+			"steps": args.steps(),
+			"profile": args.profile,
+			"angular": if args.nearest() { "nearest" } else { "blended" },
+			"density": args.density,
+			"density_multiplier": args.density_multiplier(),
+			"arrangement": args.arrangement,
+			"inspect_time": args.inspect_time,
+			"boundary_exclusion": args.obstacles && !args.no_boundary_exclusion,
+			"mode": if args.sequence.is_some() { "fixed-step encoded render sequence" } else { "real-time no captures" },
+			"mean_ms": if n > 0 { sorted.iter().sum::<f64>() / n as f64 } else { 0. },
+			"p95_ms": if n > 0 { sorted[(n * 95 / 100).min(n - 1)] } else { 0. },
+			"samples": n,
+			"focused_samples": state.focused_samples,
+			"end_groups": groups.iter().count(),
+			"angular_views_at_end": args.angular_views(state.camera(&args).translation),
+			"shared_materials": materials.len(),
+			"shared_images": images.len(),
+			"sequence": state.captures,
+			"resource_samples": state.resource_samples,
+			"resolution": window.map(|w| (w.physical_width(), w.physical_height())),
+			"completed_cycles": state.cycle + 1,
+			"animation_GPU_bytes": representation.animation_gpu_bytes(),
+			"playback_upload_bytes": 0
+		});
+		println!("MATCHED_DUST_RESULT {result}");
+		if let Some(path) = &args.result {
+			if let Err(error) =
+				std::fs::write(path, serde_json::to_vec_pretty(&result).unwrap_or_default())
+			{
+				eprintln!("result write failed: {error}");
+			}
+		}
+		exit.write(AppExit::Success);
+	}
+}
+
+impl Args {
+	fn angular_views(&self, camera: Vec3) -> Vec<serde_json::Value> {
+		if self.representation != "B+" {
+			return Vec::new();
+		}
+		(0..self.groups)
+			.map(|g| {
+				let delta = camera - self.origin(g) - DustBounds::QUAD_CENTRE;
+				let theta = delta.x.atan2(delta.z);
+				let (i, j, w) = DustMultiView::views(theta, self.nearest());
+				serde_json::json!({
+					"group": g,
+					"azimuth_degrees": theta.to_degrees(),
+					"elevation_degrees": delta.y.atan2(Vec2::new(delta.x, delta.z).length()).to_degrees(),
+					"views": [i, j],
+					"blend": w * w * (3. - 2. * w)
+				})
+			})
+			.collect()
+	}
+
+	fn steps(&self) -> u32 {
+		self.steps.unwrap_or(if self.profile == "lower" { 48 } else { 96 })
+	}
+
+	fn nearest(&self) -> bool {
+		self.angular.as_deref().map_or(self.profile == "lower", |a| a == "nearest")
+	}
+
+	fn density_multiplier(&self) -> f32 {
+		match self.density.as_str() {
+			"sparse" => 0.65,
+			"denser" => 1.35,
+			_ => 1.,
+		}
+	}
+
+	fn origin(&self, g: u32) -> Vec3 {
+		if self.groups <= 1 {
+			Vec3::ZERO
+		} else if self.arrangement == "spread" {
+			let columns = self.groups.min(4);
+			let rows = self.groups.div_ceil(columns);
+			let x = g % columns;
+			let z = g / columns;
+			Vec3::new(
+				(x as f32 - (columns - 1) as f32 * 0.5) * 4.5,
+				0.,
+				(z as f32 - (rows - 1) as f32 * 0.5) * 4.5,
+			)
+		} else {
+			let a = g as f32 * 2.399963;
+			Vec3::new(a.cos(), 0., a.sin()) * (0.28 * (g as f32).sqrt())
+		}
+	}
+}
