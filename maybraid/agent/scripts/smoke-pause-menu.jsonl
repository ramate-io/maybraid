{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"start"}
{"cmd":"wait_for","screen":"none","flow":"world","pause":"playing","timeout":10}
{"cmd":"expect","screen":"none","flow":"world","pause":"playing"}
{"cmd":"quit"}
