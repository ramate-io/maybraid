+//! Opt-in persistence for the three CPU-authored, shader-read-only bin inputs.
+//! No global RawBufferVec behavior is changed; mutable deref is forbidden.
+use crate::{
+    render_resource::{BufferId, RawBufferVec},
+    renderer::{RenderDevice, RenderQueue},
+};
+use bytemuck::NoUninit;
+use core::ops::Deref;
+use maybraid_render_prep_diagnostics::{UploadMode, UploadOutcome, UploadState};
+use wgpu::BufferUsages;
+
+pub struct BinnedInputBuffer<T: NoUninit> {
+    raw: RawBufferVec<T>,
+    state: UploadState<BufferId>,
+    mode: UploadMode,
+    usage: BufferUsages,
+    device: Option<RenderDevice>,
+    last_write: UploadOutcome,
+    #[cfg(feature = "render-prep-diagnostics")]
+    submitted: maybraid_render_prep_diagnostics::SubmittedBytes,
+}
+
+impl<T: NoUninit> BinnedInputBuffer<T> {
+    pub fn new(usage: BufferUsages) -> Self {
+        let mode = UploadMode::runtime();
+        bevy_log::info_once!("native_binned_dirty_uploads mode={}", mode.name());
+        Self::with_mode(usage, mode)
+    }
+
+    fn with_mode(usage: BufferUsages, mode: UploadMode) -> Self {
+        Self {
+            raw: RawBufferVec::new(usage),
+            state: UploadState::default(),
+            mode,
+            usage,
+            device: None,
+            last_write: UploadOutcome::default(),
+            #[cfg(feature = "render-prep-diagnostics")]
+            submitted: Default::default(),
+        }
+    }
+
+    pub fn push(&mut self, value: T) -> usize {
+        self.state.changed();
+        self.raw.push(value)
+    }
+
+    pub fn set(&mut self, index: u32, value: T) {
+        self.state.changed();
+        self.raw.set(index, value);
+    }
+
+    pub fn values_mut(&mut self) -> &mut Vec<T> {
+        self.state.changed();
+        self.raw.values_mut()
+    }
+
+    pub fn swap_remove(&mut self, index: usize) -> T {
+        self.state.changed();
+        self.raw.swap_remove(index)
+    }
+
+    pub fn set_label(&mut self, label: Option<&str>) {
+        // reserve must still process the label before the skip decision.
+        self.raw.set_label(label);
+    }
+
+    pub fn last_upload_outcome(&self) -> UploadOutcome {
+        self.last_write
+    }
+
+    pub fn write_buffer(&mut self, device: &RenderDevice, queue: &RenderQueue) {
+        self.last_write = UploadOutcome::default();
+        if self.mode == UploadMode::Force {
+            // The A path always requests exactly the native RawBufferVec write.
+            // Diagnostic snapshots are absent from clean timing builds.
+            self.request_upload(device, queue);
+            return;
+        }
+        if self.raw.is_empty() {
+            return;
+        }
+        self.prepare_device(device);
+        // Growth and same-capacity label changes may replace the destination.
+        self.raw.reserve(self.raw.len(), device);
+        let destination = self.raw.buffer().map(|buffer| buffer.id());
+        if !self
+            .state
+            .needs_upload(self.mode, destination, self.raw.len())
+        {
+            #[cfg(feature = "render-prep-diagnostics")]
+            {
+                self.last_write.shadow_checked = true;
+                if !self
+                    .submitted
+                    .matches(bytemuck::cast_slice(self.raw.values()))
+                {
+                    self.last_write.shadow_mismatch = true;
+                    self.state.changed();
+                    bevy_log::error!(
+                        "native_binned_dirty_mismatch: unchanged generation differs from last submitted bytes; forcing upload"
+                    );
+                }
+            }
+            if !self.last_write.shadow_mismatch {
+                self.last_write.skipped = true;
+                return;
+            }
+        }
+        self.request_upload(device, queue);
+    }
+
+    fn prepare_device(&mut self, device: &RenderDevice) {
+        if self
+            .device
+            .as_ref()
+            .is_some_and(|previous| previous.wgpu_device() != device.wgpu_device())
+        {
+            self.state.invalidate_destination();
+            let mut replacement = RawBufferVec::new(self.usage);
+            replacement.set_label(self.raw.get_label());
+            core::mem::swap(replacement.values_mut(), self.raw.values_mut());
+            self.raw = replacement;
+        }
+        if self
+            .device
+            .as_ref()
+            .is_none_or(|previous| previous.wgpu_device() != device.wgpu_device())
+        {
+            self.device = Some(device.clone());
+        }
+    }
+
+    fn request_upload(&mut self, device: &RenderDevice, queue: &RenderQueue) {
+        #[cfg(feature = "render-prep-diagnostics")]
+        {
+            self.last_write.queued_equal = !self.raw.is_empty()
+                && self
+                    .submitted
+                    .matches(bytemuck::cast_slice(self.raw.values()));
+        }
+        self.raw.write_buffer(device, queue);
+        let destination = self.raw.buffer().map(|buffer| buffer.id());
+        self.last_write.queued = !self.raw.is_empty() && destination.is_some();
+        if self.last_write.queued {
+            self.state.queued(destination, self.raw.len());
+            #[cfg(feature = "render-prep-diagnostics")]
+            self.submitted
+                .submitted(bytemuck::cast_slice(self.raw.values()));
+        }
+    }
+}
+
+impl<T: NoUninit> Deref for BinnedInputBuffer<T> {
+    type Target = RawBufferVec<T>;
+    fn deref(&self) -> &Self::Target {
+        &self.raw
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::render_phase::binned_input::BinnedInputBuffer;
+    use crate::render_resource::BufferId;
+    use maybraid_render_prep_diagnostics::UploadMode;
+    use wgpu::BufferUsages;
+
+    fn acknowledge(buffer: &mut BinnedInputBuffer<u32>, id: BufferId) {
+        let len = buffer.len();
+        buffer.state.queued(Some(id), len);
+    }
+
+    #[test]
+    fn native_mutators_invalidate_equal_length_and_swap_displacement() {
+        let mut buffer = BinnedInputBuffer::with_mode(BufferUsages::STORAGE, UploadMode::Dirty);
+        let id = BufferId::new();
+        buffer.push(10);
+        buffer.push(20);
+        acknowledge(&mut buffer, id);
+        assert!(!buffer.state.needs_upload(UploadMode::Dirty, Some(id), 2));
+        buffer.set(0, 11);
+        assert!(buffer.state.needs_upload(UploadMode::Dirty, Some(id), 2));
+        acknowledge(&mut buffer, id);
+        assert_eq!(buffer.swap_remove(0), 11);
+        assert_eq!(buffer.values(), &[20]);
+        assert!(buffer.state.needs_upload(UploadMode::Dirty, Some(id), 1));
+        buffer.push(30);
+        acknowledge(&mut buffer, id);
+        buffer.values_mut()[0] = 21;
+        assert!(buffer.state.needs_upload(UploadMode::Dirty, Some(id), 2));
+    }
+
+    #[test]
+    fn clear_refill_and_mutable_metadata_updates_preserve_independent_state() {
+        let mut first = BinnedInputBuffer::with_mode(BufferUsages::STORAGE, UploadMode::Dirty);
+        let mut second = BinnedInputBuffer::with_mode(BufferUsages::STORAGE, UploadMode::Dirty);
+        let id = BufferId::new();
+        first.push(1);
+        second.push(2);
+        acknowledge(&mut first, id);
+        acknowledge(&mut second, id);
+        first.values_mut().clear();
+        first.values_mut().resize(1, 3);
+        assert!(first.state.needs_upload(UploadMode::Dirty, Some(id), 1));
+        assert!(!second.state.needs_upload(UploadMode::Dirty, Some(id), 1));
+        acknowledge(&mut first, id);
+        first.values_mut()[0] += 1;
+        assert!(first.state.needs_upload(UploadMode::Dirty, Some(id), 1));
+        assert_eq!(second.values(), &[2]);
+    }
+}
