+			global_translation: [0.; 3],
+			local_rotation: [0., 0., 0., 1.],
+			global_rotation: [0., 0., 0., 1.],
+			controller_yaw: 0.,
+			controller_pitch: 0.,
+			projection: AgentCameraProjection::Perspective {
+				fov: 1.,
+				near: 0.1,
+				far: 1000.,
+				aspect_ratio: 1.,
+			},
+		};
+		let mut meshes = Assets::<Mesh>::default();
+		let mesh = meshes.add(Sphere::new(1.).mesh().ico(1)?);
+		let mut materials = Assets::<StandardMaterial>::default();
+		let material = materials.add(StandardMaterial::default());
+		world.insert_resource(meshes);
+		world.insert_resource(materials);
+		let mut spheres = Vec::new();
+		for x in 1..=12 {
+			spheres.push(
+				world
+					.spawn((
+						CanopyShadowProxy,
+						Mesh3d(mesh.clone()),
+						MeshMaterial3d(material.clone()),
+						GlobalTransform::from_translation(Vec3::X * x as f32),
+						InheritedVisibility::VISIBLE,
+						proxy_render_layers(),
+					))
+					.id(),
+			);
+		}
+		let host = world.spawn(lod::LodSceneHost).id();
+		world.spawn((
+			Name::new("building-walk-collider"),
+			ChildOf(host),
+			GlobalTransform::from_translation(Vec3::X * 1000.),
+		));
+		let wall = world
+			.spawn((
+				Name::new("visible-wall"),
+				Aabb {
+					center: Vec3::new(0., 0., -999.).into(),
+					half_extents: Vec3::new(1., 2., 3.).into(),
+				},
+				GlobalTransform::from(
+					Transform::from_translation(Vec3::X * 1000.)
+						.with_rotation(Quat::from_rotation_y(std::f32::consts::FRAC_PI_2)),
+				),
+				ChildOf(host),
+				Mesh3d(mesh.clone()),
+				MeshMaterial3d(material),
+				InheritedVisibility::VISIBLE,
+				NotShadowReceiver,
+			))
+			.id();
+		for i in 0..BUILDING_MESH_LIMIT {
+			world.spawn((
+				ChildOf(host),
+				Mesh3d(mesh.clone()),
+				Aabb::default(),
+				GlobalTransform::from_translation(Vec3::X * (100. + i as f32)),
+			));
+		}
+
+		// An apparently nearer origin owns physically farther geometry. Ranking
+		// by origin would pick this host first; real world bounds must not.
+		let decoy = world.spawn(lod::LodSceneHost).id();
+		world.spawn((
+			Name::new("building-walk-collider"),
+			ChildOf(decoy),
+			GlobalTransform::IDENTITY,
+		));
+		world.spawn((
+			ChildOf(decoy),
+			Mesh3d(mesh.clone()),
+			Aabb::default(),
+			GlobalTransform::from_translation(Vec3::X * 10.),
+		));
+		world.spawn((ChildOf(host), Mesh3d(mesh.clone()))); // bounds unavailable, never zero distance
+		let mut parent = host;
+		for _ in 0..BUILDING_ANCESTOR_LIMIT {
+			parent = world.spawn(ChildOf(parent)).id();
+		}
+		world.spawn((
+			ChildOf(parent),
+			Mesh3d(mesh.clone()),
+			Aabb::default(),
+			GlobalTransform::IDENTITY,
+		));
+		let mut cascades = Cascades::default();
+		cascades.cascades.insert(camera_entity, vec![Default::default()]);
+		let mut visible = CascadesVisibleEntities::default();
+		visible
+			.entities
+			.insert(camera_entity, vec![VisibleMeshEntities { entities: vec![spheres[0], wall] }]);
+		visible
+			.entities
+			.insert(other_camera, vec![VisibleMeshEntities { entities: vec![spheres[1]] }]);
+		let sun = world
+			.spawn((
+				maybraid_sky::SkySun,
+				DirectionalLight { shadow_maps_enabled: true, ..default() },
+				cascades,
+				visible,
+				RenderLayers::default().with(vegetation_components::SHADOW_PROXY_RENDER_LAYER),
+			))
+			.id();
+		let data = snapshot(&mut world, &camera, 1);
+		assert_eq!(data["spheres"].as_array().map(Vec::len), Some(LIMIT));
+		assert_eq!(data["total_markers"], 12);
+		assert_eq!(data["spheres"][0]["entity"], spheres[0].to_bits().to_string());
+		assert_eq!(data["spheres"][0]["listed_cascade_indices"], serde_json::json!([0]));
+		assert_eq!(data["spheres"][1]["listed_cascade_indices"], serde_json::json!([]));
+		assert_eq!(data["spheres"][0]["mesh_asset_loaded"], true);
+		assert_eq!(data["spheres"][0]["camera_layer_intersection"], false);
+		assert_eq!(data["spheres"][0]["light_layer_intersection"], true);
+		assert_eq!(data["buildings"].as_array().map(Vec::len), Some(2));
+		assert_eq!(data["building_scan"]["mesh_ancestry_limit_reached"], 1);
+		assert_eq!(data["building_scan"]["missing_or_invalid_building_mesh_bounds"], 1);
+		let building = &data["buildings"][0];
+		assert_eq!(building["host"], host.to_bits().to_string());
+		assert_eq!(building["observed_meshes"], BUILDING_MESH_LIMIT + 2);
+		assert_eq!(building["omitted_mesh_records"], 1);
