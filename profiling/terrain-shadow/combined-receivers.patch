+		world.insert_resource(materials);
+		let mut spheres = Vec::new();
+		for x in 1..=12 {
+			spheres.push(
+				world
+					.spawn((
+						CanopyShadowProxy,
+						Mesh3d(mesh.clone()),
+						MeshMaterial3d(material.clone()),
+						GlobalTransform::from_translation(Vec3::X * x as f32),
+						InheritedVisibility::VISIBLE,
+						proxy_render_layers(),
+					))
+					.id(),
+			);
+		}
+		let host = world.spawn(lod::LodSceneHost).id();
+		world.spawn((
+			Name::new("building-walk-collider"),
+			ChildOf(host),
+			GlobalTransform::from_translation(Vec3::X * 2.),
+		));
+		let wall = world
+			.spawn((
+				Name::new("visible-wall"),
+				ChildOf(host),
+				Mesh3d(mesh.clone()),
+				MeshMaterial3d(material),
+				InheritedVisibility::VISIBLE,
+				NotShadowReceiver,
+			))
+			.id();
+		for _ in 0..BUILDING_NODE_LIMIT {
+			world.spawn(ChildOf(host));
+		}
+		let mut cascades = Cascades::default();
+		cascades.cascades.insert(camera_entity, vec![Default::default()]);
+		let mut visible = CascadesVisibleEntities::default();
+		visible
+			.entities
+			.insert(camera_entity, vec![VisibleMeshEntities { entities: vec![spheres[0], wall] }]);
+		visible
+			.entities
+			.insert(other_camera, vec![VisibleMeshEntities { entities: vec![spheres[1]] }]);
+		let sun = world
+			.spawn((
+				maybraid_sky::SkySun,
+				DirectionalLight { shadow_maps_enabled: true, ..default() },
+				cascades,
+				visible,
+				RenderLayers::default().with(vegetation_components::SHADOW_PROXY_RENDER_LAYER),
+			))
+			.id();
+		let data = snapshot(&mut world, &camera, 1);
+		assert_eq!(data["spheres"].as_array().map(Vec::len), Some(LIMIT));
+		assert_eq!(data["total_markers"], 12);
+		assert_eq!(data["spheres"][0]["entity"], spheres[0].to_bits().to_string());
+		assert_eq!(data["spheres"][0]["listed_cascade_indices"], serde_json::json!([0]));
+		assert_eq!(data["spheres"][1]["listed_cascade_indices"], serde_json::json!([]));
+		assert_eq!(data["spheres"][0]["mesh_asset_loaded"], true);
+		assert_eq!(data["spheres"][0]["camera_layer_intersection"], false);
+		assert_eq!(data["spheres"][0]["light_layer_intersection"], true);
+		assert_eq!(data["buildings"].as_array().map(Vec::len), Some(1));
+		let building = &data["buildings"][0];
+		assert_eq!(building["host"], host.to_bits().to_string());
+		assert_eq!(building["visited_nodes"], BUILDING_NODE_LIMIT);
+		assert_eq!(building["truncated"], true);
+		assert_eq!(building["meshes"][0]["entity"], wall.to_bits().to_string());
+		assert_eq!(building["meshes"][0]["standard_material_asset_loaded"], true);
+		assert_eq!(building["meshes"][0]["listed_cascade_indices"], serde_json::json!([0]));
+		assert_eq!(building["meshes"][0]["not_shadow_receiver"], true);
+		world.entity_mut(sun).remove::<CascadesVisibleEntities>();
+		assert_eq!(snapshot(&mut world, &camera, 2)["state"], "not-computed-for-camera");
+		Ok(())
+	}
+}
