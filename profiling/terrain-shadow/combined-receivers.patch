+++ b/maybraid/world/lib/src/agent/diagnostics/shadow_admission.rs
@@ -0,0 +1,357 @@
+//! Explicit, read-only shadow fixture evidence. Never installed as a scan system.
+
+use bevy::{
+	camera::visibility::{
+		CascadesVisibleEntities, RenderLayers, VisibleEntities, VisibleMeshEntities,
+	},
+	light::{
+		CascadeShadowConfig, Cascades, DirectionalLightShadowMap, NotShadowCaster,
+		NotShadowReceiver,
+	},
+	prelude::*,
+};
+use maybraid_agent::AgentCameraSnapshot;
+use std::collections::VecDeque;
+use vegetation_components::{CanopyShadowProxy, shadow_proxy::proxy_render_layers};
+
+const LIMIT: usize = 8;
+const BUILDING_LIMIT: usize = 3;
+const BUILDING_NODE_LIMIT: usize = 48;
+
+fn nearest_buildings(world: &mut World, camera_position: Vec3) -> Vec<(f32, Entity, Entity)> {
+	let mut result = Vec::with_capacity(BUILDING_LIMIT + 1);
+	let mut named = world.query::<(Entity, &Name, &ChildOf, &GlobalTransform)>();
+	for (collider, name, parent, pose) in named.iter(world) {
+		// The production walk-collider attachment stamps this exact name on a
+		// fixed compound child of the building's actual LOD scene host.
+		let host = parent.parent();
+		if name.as_str() != "building-walk-collider"
+			|| world.get::<lod::LodSceneHost>(host).is_none()
+		{
+			continue;
+		}
+		let distance = pose.translation().distance_squared(camera_position);
+		if !distance.is_finite() {
+			continue;
+		}
+		let index = result.partition_point(|(d, e, _): &(f32, Entity, Entity)| {
+			*d < distance || (*d == distance && e.to_bits() < host.to_bits())
+		});
+		if index < BUILDING_LIMIT && !result.iter().any(|(_, owner, _)| *owner == host) {
+			result.insert(index, (distance, host, collider));
+			result.truncate(BUILDING_LIMIT);
+		}
+	}
+	result
+}
+
+fn building_snapshot(
+	world: &World,
+	host: Entity,
+	collider: Entity,
+	distance: f32,
+	cascades: Option<&[VisibleMeshEntities]>,
+	camera_layers: &RenderLayers,
+	light_layers: &RenderLayers,
+	camera_meshes: Option<&[Entity]>,
+) -> serde_json::Value {
+	let meshes = world.get_resource::<Assets<Mesh>>();
+	let materials = world.get_resource::<Assets<StandardMaterial>>();
+	let mut frontier = VecDeque::from([host]);
+	let mut observed_meshes = Vec::new();
+	let mut visited = 0;
+	let mut truncated = false;
+	while let Some(entity) = frontier.pop_front() {
+		visited += 1;
+		if let Some(children) = world.get::<Children>(entity) {
+			let remaining = BUILDING_NODE_LIMIT - visited - frontier.len();
+			truncated |= children.len() > remaining;
+			frontier.extend(children[..remaining.min(children.len())].iter().copied());
+		}
+		let Some(mesh) = world.get::<Mesh3d>(entity) else {
+			continue;
+		};
+		let material = world.get::<MeshMaterial3d<StandardMaterial>>(entity);
+		let layers = world.get::<RenderLayers>(entity).cloned().unwrap_or_default();
+		let cascade_indices = cascades.map(|lists| {
+			lists
+				.iter()
+				.enumerate()
+				.filter_map(|(index, list)| list.entities.contains(&entity).then_some(index))
+				.collect::<Vec<_>>()
+		});
+		observed_meshes.push(serde_json::json!({
+			"entity": entity.to_bits().to_string(),
+			"name": world.get::<Name>(entity).map(Name::as_str),
+			"translation": world.get::<GlobalTransform>(entity).map(|p| p.translation().to_array()),
+			"mesh_path": mesh.0.path().map(ToString::to_string),
+			"mesh_asset_loaded": meshes.map(|assets| assets.contains(mesh.id())),
+			"standard_material_asset_loaded": material.zip(materials).map(|(material, assets)| assets.contains(material.id())),
+			"inherited_visible": world.get::<InheritedVisibility>(entity).map(|v| v.get()),
+			"camera_listed": camera_meshes.map(|list| list.contains(&entity)),
+			"not_shadow_caster": world.get::<NotShadowCaster>(entity).is_some(),
+			"not_shadow_receiver": world.get::<NotShadowReceiver>(entity).is_some(),
+			"camera_layer_intersection": layers.intersects(camera_layers),
+			"light_layer_intersection": layers.intersects(light_layers),
+			"listed_cascade_indices": cascade_indices,
+		}));
+	}
+	serde_json::json!({
+		"host": host.to_bits().to_string(),
+		"walk_collider": collider.to_bits().to_string(),
+		"anchor_translation": world.get::<GlobalTransform>(collider).map(|p| p.translation().to_array()),
+		"anchor_distance_m": distance.sqrt(),
+		"visited_nodes": visited,
+		"truncated": truncated,
+		"meshes": observed_meshes,
+	})
+}
+
+pub(super) fn capture(world: &mut World, camera: &AgentCameraSnapshot, request: u32) {
+	if std::env::var("MAYBRAID_SHADOW_ADMISSION").as_deref() != Ok("1") {
+		return;
+	}
+	let result = snapshot(world, camera, request);
+	info!(target:"maybraid.shadow.admission", "shadow_admission {}",result);
+}
+
+fn snapshot(world: &mut World, camera: &AgentCameraSnapshot, request: u32) -> serde_json::Value {
+	let camera_entity = camera.entity.parse::<u64>().ok().and_then(Entity::try_from_bits);
+	let camera_position = Vec3::from_array(camera.global_translation);
+	let camera_layers = camera_entity
+		.and_then(|e| world.get::<RenderLayers>(e))
+		.cloned()
+		.unwrap_or_default();
+	let mut nearest = Vec::with_capacity(LIMIT + 1);
+	let mut total = 0usize;
+	let mut unrealized = 0usize;
+	let mut missing_pose = 0usize;
+	let mut proxies = world
+		.query_filtered::<(Entity, Option<&GlobalTransform>, Has<Mesh3d>), With<CanopyShadowProxy>>(
+		);
+	for (entity, pose, realized) in proxies.iter(world) {
+		total += 1;
+		if !realized {
+			unrealized += 1;
+			continue;
+		}
+		let Some(pose) = pose else {
+			missing_pose += 1;
+			continue;
+		};
+		let distance = pose.translation().distance_squared(camera_position);
+		if !distance.is_finite() {
+			missing_pose += 1;
+			continue;
+		}
+		let index = nearest.partition_point(|(d, e): &(f32, Entity)| {
+			*d < distance || (*d == distance && e.to_bits() < entity.to_bits())
+		});
+		if index < LIMIT {
+			nearest.insert(index, (distance, entity));
+			nearest.truncate(LIMIT);
+		}
+	}
+	let buildings = nearest_buildings(world, camera_position);
+	let mut suns = world.query_filtered::<Entity, With<maybraid_sky::SkySun>>();
+	let sun_ids: Vec<_> = suns.iter(world).take(2).collect();
+	let sun = (sun_ids.len() == 1).then(|| sun_ids[0]);
+	let light = sun.and_then(|e| world.get::<DirectionalLight>(e));
+	let light_layers = sun.and_then(|e| world.get::<RenderLayers>(e)).cloned().unwrap_or_default();
+	let cascades = sun
+		.and_then(|e| world.get::<Cascades>(e))
+		.and_then(|c| camera_entity.and_then(|v| c.cascades.get(&v)));
+	let visible = sun
+		.and_then(|e| world.get::<CascadesVisibleEntities>(e))
+		.and_then(|c| camera_entity.and_then(|v| c.entities.get(&v)));
+	let state = if sun_ids.len() != 1 {
+		"unknown-single-sun-required"
+	} else if light.is_none() {
+		"unknown-light-component-missing"
+	} else if !light.is_some_and(|l| l.shadow_maps_enabled) {
+		"maps-disabled"
+	} else if cascades.is_none() || visible.is_none() {
+		"not-computed-for-camera"
+	} else if cascades.map_or(0, Vec::len) != visible.map_or(0, Vec::len) {
+		"unknown-cascade-count-mismatch"
+	} else {
+		"present-main-world-membership-unstamped"
+	};
+	let membership_tick = sun
+		.and_then(|entity| world.get_entity(entity).ok())
+		.and_then(|entity| entity.get_ref::<CascadesVisibleEntities>())
+		.map(|visible| (visible.last_changed().get(), visible.is_changed()));
+	let spheres: Vec<_> = nearest.into_iter().map(|(distance, entity)| {
+        let pose = world.get::<GlobalTransform>(entity);
+        let layers = world.get::<RenderLayers>(entity).cloned().unwrap_or_default();
+        let listed: Option<Vec<_>> = visible.map(|cs| cs.iter().enumerate().filter_map(|(index, c)| c.entities.contains(&entity).then_some(index)).collect());
+        let mut ancestor = world.get::<ChildOf>(entity).map(ChildOf::parent);
+        let mut ancestor_suppressed = false;
+        let mut checked = 0;
+        while let Some(parent) = ancestor {
+            if checked == 32 { break; }
+            ancestor_suppressed |= world.get::<NotShadowCaster>(parent).is_some();
+            ancestor = world.get::<ChildOf>(parent).map(ChildOf::parent);
+            checked += 1;
+        }
+        serde_json::json!({"entity": entity.to_bits().to_string(), "distance_m": distance.sqrt(),
+            "translation": pose.map(|p| p.translation().to_array()), "scale": pose.map(|p| p.to_scale_rotation_translation().0.to_array()),
+            "inherited_visible": world.get::<InheritedVisibility>(entity).map(|v| v.get()),
+            "not_shadow_caster": world.get::<NotShadowCaster>(entity).is_some(),
+            "marked_ancestor": ancestor_suppressed, "ancestor_inspection_complete": ancestor.is_none(),
+            "mesh_asset_loaded":world.get_resource::<Assets<Mesh>>().and_then(|assets| world.get::<Mesh3d>(entity).map(|mesh| assets.contains(mesh.id()))),
+            "material_asset_loaded":world.get_resource::<Assets<StandardMaterial>>().and_then(|assets| world.get::<MeshMaterial3d<StandardMaterial>>(entity).map(|material| assets.contains(material.id()))),
+            "camera_layer_intersection":layers.intersects(&camera_layers),
+            "proxy_layer_intersection": layers.intersects(&proxy_render_layers()),
+            "light_layer_intersection": layers.intersects(&light_layers), "layers": format!("{layers:?}"),
+            "listed_cascade_indices": listed})
+    }).collect();
+	let camera_meshes = camera_entity
+		.and_then(|entity| world.get::<VisibleEntities>(entity))
+		.map(|entities| entities.get(core::any::TypeId::of::<Mesh3d>()));
+	let buildings: Vec<_> = buildings
+		.into_iter()
+		.map(|(distance, host, collider)| {
+			building_snapshot(
+				world,
+				host,
+				collider,
+				distance,
+				visible.map(Vec::as_slice),
+				&camera_layers,
+				&light_layers,
+				camera_meshes,
+			)
+		})
+		.collect();
+	let result = serde_json::json!({"request_id":request, "t":world.resource::<Time>().elapsed_secs(),
+        "camera":camera, "camera_layers":format!("{camera_layers:?}"), "sun":sun.map(|e| e.to_bits().to_string()), "state":state,
+        "sun_pose":sun.and_then(|e| world.get::<GlobalTransform>(e)).map(|p| (p.translation().to_array(),p.rotation().to_array())),
+        "sun_illuminance":light.map(|l| l.illuminance),
+        "sun_depth_bias":light.map(|l| l.shadow_depth_bias), "sun_normal_bias":light.map(|l| l.shadow_normal_bias),
+        "directional_shadow_map_size":world.get_resource::<DirectionalLightShadowMap>().map(|m| m.size),
+        "cascade_bounds":sun.and_then(|e| world.get::<CascadeShadowConfig>(e)).map(|c| &c.bounds), "sun_color":light.map(|l| format!("{:?}",l.color)),
+        "light_layers":format!("{light_layers:?}"), "cascade_count":cascades.map(Vec::len),
+        "cascade_cpu_visible_mesh_counts":visible.map(|cs| cs.iter().map(|c| c.entities.len()).collect::<Vec<_>>()),
+        "camera_cpu_visible_mesh3d_count":camera_entity.and_then(|e|world.get::<VisibleEntities>(e)).map(|v|v.get(core::any::TypeId::of::<Mesh3d>()).len()),
+        "membership_freshness":"ECS-write-tick-only-not-a-render-stamp",
+        "membership_last_changed_tick":membership_tick.map(|t|t.0),
+        "membership_changed_since_previous_camera_completion_system_run":membership_tick.map(|t|t.1),
+        "world_previous_system_tick":world.last_change_tick().get(), "world_current_tick":world.read_change_tick().get(),
+        "gpu_shadow_submission":"not-observed",
+        "total_markers":total,"unrealized":unrealized,"missing_or_invalid_pose":missing_pose,
+        "selection":"nearest-realized-limit8", "spheres":spheres,
+        "building_selection":"nearest-live-walk-collider-hosts-limit3; descendant inspection limited to 48 nodes per host",
+        "buildings":buildings});
+	result
+}
+
+#[cfg(test)]
+mod tests {
