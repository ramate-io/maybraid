+	#[test]
+	fn physical_bounds_handle_nonuniform_reflection_and_reject_invalid_geometry() {
+		let entity = World::new().spawn_empty().id();
+		let bounds = Aabb { center: Vec3::ZERO.into(), half_extents: Vec3::ONE.into() };
+		let pose = GlobalTransform::from(
+			Transform::from_translation(Vec3::X * 10.).with_scale(Vec3::new(-2., 3., 4.)),
+		);
+		let observed = MeshBounds::observe(entity, &bounds, &pose, Vec3::ZERO);
+		assert!(observed.is_some_and(|g| g.min == Vec3::new(8., -3., -4.)
+			&& g.max == Vec3::new(12., 3., 4.)
+			&& g.distance_squared == 64.));
+		let invalid = Aabb { center: Vec3::splat(f32::NAN).into(), ..bounds };
+		assert!(MeshBounds::observe(entity, &invalid, &pose, Vec3::ZERO).is_none());
+		let invalid = Aabb { half_extents: (-Vec3::ONE).into(), ..bounds };
+		assert!(MeshBounds::observe(entity, &invalid, &pose, Vec3::ZERO).is_none());
+	}
+
+	#[test]
+	fn snapshot_bounds_real_spheres_and_joins_only_selected_camera_cascades() -> anyhow::Result<()>
+	{
+		let mut world = World::new();
+		world.init_resource::<Time>();
+		let camera_entity = world.spawn_empty().id();
+		let other_camera = world.spawn_empty().id();
+		let camera = AgentCameraSnapshot {
+			entity: camera_entity.to_bits().to_string(),
