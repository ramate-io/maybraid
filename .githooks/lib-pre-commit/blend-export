#!/bin/bash

set -e

# Allow developer to turn off with environment variable
if [ -n "$BLEND_EXPORT_DISABLE" ]; then
    echo "Blend export is disabled. Skipping..."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXPORT_SCRIPT="$REPO_ROOT/scripts/glb/main.py"
ART_PREFIX="maybraid/art/"
ASSETS_PREFIX="maybraid/assets/"

# Art `.blend` files still 1:1-export to `assets/…/*.glb` (menu thumbnails).
# Body garments also have host-fit GLBs at
# `assets/characters/clothes/body/{host}/{garment}.glb` from
# `scripts/clothes-fit`. Those are not a blend mirror: never export over them,
# and when a clothing blend is deleted, remove those host-fit copies too.

echo "Running pre-commit hook: Exporting .blend files to .glb..."

if ! command -v blender &> /dev/null; then
    echo "❌ blender command not found."
    echo "   macOS: install Blender 5.1.2 to /Applications/Blender.app and enter nix develop"
    echo "   Linux/CI: ensure you're in the nix development shell"
    exit 1
fi

if [ ! -f "$EXPORT_SCRIPT" ]; then
    echo "❌ Export script not found: $EXPORT_SCRIPT"
    exit 1
fi

# Incremental locally by default; full re-export in GitHub Actions CI.
# Override with BLEND_EXPORT_FULL=1 or BLEND_EXPORT_INCREMENTAL=1.
if [ -n "$BLEND_EXPORT_FULL" ]; then
    INCREMENTAL=0
elif [ -n "$BLEND_EXPORT_INCREMENTAL" ]; then
    INCREMENTAL=1
elif [ -n "$GITHUB_ACTIONS" ]; then
    INCREMENTAL=0
else
    INCREMENTAL=1
fi

blend_to_glb() {
    local blend_file="$1"
    echo "${blend_file#$ART_PREFIX}" | sed 's/\.blend$/.glb/'
}

is_body_clothing_blend() {
    case "$1" in
        maybraid/art/characters/clothes/body/*.blend) return 0 ;;
        *) return 1 ;;
    esac
}

stage_remove_asset() {
    local path="$1"
    if [ ! -e "$path" ] && ! git ls-files --error-unmatch -- "$path" &>/dev/null; then
        return 0
    fi
    echo "🗑️  Removing ${path}"
    if git ls-files --error-unmatch -- "$path" &>/dev/null; then
        git rm -f --quiet -- "$path"
    else
        rm -f -- "$path"
    fi
    REMOVED=$((REMOVED + 1))
}

# Remove the mirrored .glb for a deleted .blend and stage the deletion.
remove_glb_for_blend() {
    local blend_file="$1"
    local glb_file="${ASSETS_PREFIX}$(blend_to_glb "$blend_file")"
    stage_remove_asset "$glb_file"

    if is_body_clothing_blend "$blend_file"; then
        local stem
        stem="$(basename "$blend_file" .blend)"
        local host_glb
        while IFS= read -r host_glb || [ -n "$host_glb" ]; do
            [ -z "$host_glb" ] && continue
            stage_remove_asset "$host_glb"
        done < <(git ls-files -- "maybraid/assets/characters/clothes/body/*/${stem}.glb")
    fi
}

REMOVED=0

# Staged blend deletions (removed from the index) leave orphan GLBs unless cleaned here.
STAGED_DELETED_BLENDS=$(git diff --cached --diff-filter=D --name-only -- 'maybraid/art/' | grep -E '\.blend$' || true)
while IFS= read -r blend_file || [ -n "$blend_file" ]; do
    [ -z "$blend_file" ] && continue
    remove_glb_for_blend "$blend_file"
done <<< "$STAGED_DELETED_BLENDS"

BLEND_FILES=$(git ls-files --cached --exclude-standard 'maybraid/art/**/*.blend' | grep -E '\.blend$' || true)

if [ -z "$BLEND_FILES" ]; then
    if [ "$REMOVED" -gt 0 ]; then
        echo "✨ Removed ${REMOVED} orphaned .glb file(s) for deleted .blend file(s)."
        exit 0
    fi
    echo "📭 No tracked .blend files found under maybraid/art/."
    exit 0
fi

TOTAL_FILES=$(echo "$BLEND_FILES" | wc -l | tr -d ' ')
if [ "$INCREMENTAL" -eq 1 ]; then
    echo "📝 Found $TOTAL_FILES tracked .blend files (incremental mode)"
else
    echo "📝 Found $TOTAL_FILES tracked .blend files (full export)"
fi

CURRENT=0
EXPORTED=0
SKIPPED=0
STAGED_FILES=()

needs_export() {
    local blend_file="$1"
    local glb_file="$2"

    if [ "$INCREMENTAL" -eq 0 ]; then
        return 0
    fi

    if [ ! -f "$glb_file" ]; then
        return 0
    fi

    if [ "$blend_file" -nt "$glb_file" ]; then
        return 0
    fi

    return 1
}

while IFS= read -r blend_file || [ -n "$blend_file" ]; do
    [ -z "$blend_file" ] && continue

    CURRENT=$((CURRENT + 1))
    relative_path="$(blend_to_glb "$blend_file")"
    glb_file="${ASSETS_PREFIX}${relative_path}"

    # Never write a catalog export into a host-fit directory.
    if [ -d "$glb_file" ]; then
        echo "❌ Refusing to export over directory ${glb_file} (host-fit clothing lives here)"
        exit 1
    fi

    # Indexed but missing on disk (e.g. AD / worktree deletion) — clean GLB, skip Blender.
    if [ ! -f "$blend_file" ]; then
        remove_glb_for_blend "$blend_file"
        echo "⏭️  Skipping deleted ${blend_file} (${CURRENT}/${TOTAL_FILES})"
        continue
    fi

    if ! needs_export "$blend_file" "$glb_file"; then
        SKIPPED=$((SKIPPED + 1))
        echo "⏭️  Skipping up-to-date ${blend_file} (${CURRENT}/${TOTAL_FILES})"
        continue
    fi

    echo "🔍 Exporting ${blend_file} → ${glb_file} (${CURRENT}/${TOTAL_FILES})..."
    if blender --background "$blend_file" --python "$EXPORT_SCRIPT" -- "$glb_file"; then
        EXPORTED=$((EXPORTED + 1))
        STAGED_FILES+=("$glb_file")
    else
        echo "❌ Failed to export ${blend_file}"
        echo "💡 Tips:"
        echo "   - Ensure the .blend file opens cleanly in Blender"
        echo "   - Run manually: blender --background \"${blend_file}\" --python \"${EXPORT_SCRIPT}\" -- \"${glb_file}\""
        echo "   - To force full re-export locally: BLEND_EXPORT_FULL=1"
        exit 1
    fi
done <<< "$BLEND_FILES"

if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
    git add -- "${STAGED_FILES[@]}"
fi

if [ "$EXPORTED" -eq 0 ] && [ "$SKIPPED" -gt 0 ] && [ "$REMOVED" -eq 0 ]; then
    echo "✨ All GLB exports are up to date (${SKIPPED} skipped)."
elif [ "$EXPORTED" -gt 0 ] || [ "$REMOVED" -gt 0 ]; then
    if [ "$EXPORTED" -gt 0 ]; then
        echo "✨ Exported ${EXPORTED} .glb file(s)."
    fi
    if [ "$REMOVED" -gt 0 ]; then
        echo "✨ Removed ${REMOVED} orphaned .glb file(s) for deleted .blend file(s)."
    fi
    if [ "$SKIPPED" -gt 0 ]; then
        echo "   Skipped ${SKIPPED} up-to-date file(s)."
    fi
else
    echo "✨ Blend export completed."
fi

if [ "$INCREMENTAL" -eq 1 ]; then
    echo "ℹ️  Incremental export is the local default; use BLEND_EXPORT_FULL=1 to re-export all .blend files"
fi
exit 0
